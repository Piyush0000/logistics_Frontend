# Gateway base URL. Used only by server code, never sent to the browser.
GATEWAY_URL=http://localhost:8080

# Development credentials, ignored in production. Do not prefix these with NEXT_PUBLIC_.
# Shipment reads in gateway mock mode accept demo-merchant-001 or demo-merchant-002.
DEV_SHIPMENTS_TOKEN=demo-merchant-001
# Webhook routes need a merchant key of at least 32 characters.
DEV_WEBHOOK_TOKEN=

# Per-feature data source: gateway or mock. A feature with no value uses mock.
# Shipments, tracking and webhooks have gateway routes.
# DATA_SOURCE_SHIPMENTS=gateway
# DATA_SOURCE_TRACKING=gateway
# DATA_SOURCE_WEBHOOKS=gateway
# DATA_SOURCE_ORDERS=gateway   # list route works in mock mode only; booking route exists but always answers 503 for now; no detail route
# DATA_SOURCE_NDR=mock          # no route; gateway shows NDR (screen, actions, Home tile) as unavailable
# Session, overview, wallet and COD have no gateway routes yet, so gateway shows them as unavailable.
# DATA_SOURCE_SESSION=mock
# DATA_SOURCE_OVERVIEW=mock
# DATA_SOURCE_WALLET=mock
# DATA_SOURCE_COD=mock
# DATA_SOURCE_ONBOARDING=mock   # setup checklist, no route
# DATA_SOURCE_B2B=mock          # multi-box shipments, no route; gateway shows it as unavailable
# DATA_SOURCE_PICKUP_ADDRESSES=mock   # saved pickup addresses, no route
# DATA_SOURCE_PICKUPS=mock   # pickups have no route, so gateway shows them as unavailable; ready-to-ship reads shipments through DATA_SOURCE_ORDERS
# DATA_SOURCE_RTO=mock   # lists and counts use the shipments routes; RTO charges have no source, so the tile shows Not available yet
# DATA_SOURCE_ANALYTICS=mock   # per-day delivered and revenue charts, no route, so gateway shows them as unavailable; the delivered total reads shipments stats through DATA_SOURCE_SHIPMENTS
# DATA_SOURCE_INVOICES=mock   # no invoice route, so gateway shows invoices as unavailable
# DATA_SOURCE_WEIGHT=mock   # no weight route, so gateway shows weight discrepancies as unavailable
# DATA_SOURCE_WEIGHT_SETTINGS=mock   # no package preset route, so gateway shows presets as unavailable
# DATA_SOURCE_RATES=mock   # no rate card or serviceability route, so gateway shows the rate card and quotes as unavailable
# DATA_SOURCE_PROFILE=mock   # no profile route, so gateway shows the profile and password change as unavailable
# DATA_SOURCE_TEAM=mock   # no team route, so gateway shows the team and its invite, role and remove actions as unavailable
