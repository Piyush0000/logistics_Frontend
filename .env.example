# Gateway base URL. Used only by server code, never sent to the browser.
GATEWAY_URL=http://localhost:8080

# Development credentials, ignored in production. Do not prefix these with NEXT_PUBLIC_.
# Shipment reads in gateway mock mode accept demo-merchant-001 or demo-merchant-002.
DEV_SHIPMENTS_TOKEN=demo-merchant-001
# Webhook routes need a merchant key of at least 32 characters.
DEV_WEBHOOK_TOKEN=

# Per-feature data source: gateway or mock. A feature with no value uses mock.
# Shipments, tracking and webhooks have gateway routes.
# DATA_SOURCE_SHIPMENTS=gateway
# DATA_SOURCE_TRACKING=gateway
# DATA_SOURCE_WEBHOOKS=gateway
# Session, overview, wallet and COD have no gateway routes yet, so gateway shows them as unavailable.
# DATA_SOURCE_SESSION=mock
# DATA_SOURCE_OVERVIEW=mock
# DATA_SOURCE_WALLET=mock
# DATA_SOURCE_COD=mock
